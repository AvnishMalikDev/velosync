# VeloSync — canonical environment (repository root `.env`)
#
# Dashboard, Admin UI, HTTPS, PM2, and jira-md-export all read this file (canonical).
# jira-md-export/.env is legacy only; if both exist, the root `.env` wins.
#
# First-time (from repository root):
#   copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Do not commit .env with real secrets.

# ---------------------------------------------------------------------------
# Platform & authentication
# ---------------------------------------------------------------------------
# local = username/password (rbac.json). azure = Microsoft Entra ID SSO.
AUTH_MODE=local

# When AUTH_MODE=azure, set to 1 to also show username/password on /login.
# ALLOW_LOCAL_LOGIN=1

# Azure AD — required when AUTH_MODE=azure
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# OAuth redirect and logout (must match Azure app registration when using SSO)
REDIRECT_URI=
POST_LOGOUT_REDIRECT_URI=

# Cookie signing — use a long random string in production (16+ characters)
SESSION_SECRET=your-session-secret-change-in-production

# Public URL (Azure redirect / logout must match exactly)
# Switch environment: local dev OR production host (one block active).
#
# Local development (HTTP):
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
#
# Production (example: HTTPS, self-signed cert — paths relative to this repo root)
# Comment the two lines above, then uncomment and adjust:
# PUBLIC_BASE_URL=https://10.6.12.132
# PORT=443
# USE_HTTPS=1
# SSL_KEY_PATH=key.pem
# SSL_CERT_PATH=cert.pem
#
# Optional overrides (normally leave unset):
# REDIRECT_URI=https://10.6.12.132/auth/callback
# POST_LOGOUT_REDIRECT_URI=https://10.6.12.132

# HTTPS — use Admin → HTTPS/SSL to upload PEMs (writes ssl/server.key & ssl/server.crt) or set paths by hand
USE_HTTPS=
SSL_KEY_PATH=
SSL_CERT_PATH=

# OpenRouter (AI features). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Corporate TLS/proxy: set to 1 if you see certificate errors to external APIs ("unable to get local issuer certificate")
ALLOW_INSECURE_TLS=1

# PM2 app name (match: pm2 start … --name …)
PM2_WEB_PROCESS_NAME=velosync-web

# ---------------------------------------------------------------------------
# Jira (export pipeline)
# ---------------------------------------------------------------------------
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_DOMAIN=

# Optional global Jira custom field IDs (per-project overrides in projects.json win)
# JIRA_WORK_CLASSIFICATION_FIELD_ID=
# JIRA_ACTUAL_STORY_POINTS_FIELD_ID=
# JIRA_QA_POINTS_FIELD_ID=
# JIRA_QA_ASSIGNEE_FIELD_ID=

# ---------------------------------------------------------------------------
# Optional connectors (enable toggles in Admin → Connectors)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
ORG=
ENT=
CURSOR_TOKEN=
TESTRAIL_DOMAIN=
TESTRAIL_EMAIL=
TESTRAIL_API_KEY=
